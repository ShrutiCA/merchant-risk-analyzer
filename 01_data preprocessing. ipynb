    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# --- STEP 1: GENERATE AND CLEAN MOCK DATA ---\n",
    "np.random.seed(42)\n",
    "\n",
    "n_rows = 200\n",
    "data = {\n",
    "    \"transaction_id\": [f\"TXN_{1000 + i}\" for i in range(n_rows)],\n",
    "    \"merchant_id\": np.random.choice([f\"MERCH_{str(i).zfill(3)}\" for i in range(1, 15)], n_rows),\n",
    "    \"amount\": np.round(np.random.exponential(scale=50.0, size=n_rows) + 5.0, 2),\n",
    "    \"transaction_hour\": np.random.randint(0, 24, size=n_rows),\n",
    "    \"location\": np.random.choice([\"Mumbai\", \"Pune\", \"Bangalore\", \"Delhi\", \"Chennai\", \"Remote_Proxy\"], size=n_rows, p=[0.3, 0.4, 0.1, 0.1, 0.05, 0.05]),\n",
    "    \"status\": np.random.choice([\"SUCCESS\", \"FAILED\", \"PENDING\"], size=n_rows, p=[0.85, 0.10, 0.05])\n",
    "}\n",
    "\n",
    "df_mock = pd.DataFrame(data)\n",
    "\n",
    "# Inject intentional missing values to practice cleaning\n",
    "df_mock.loc[15, \"amount\"] = np.nan\n",
    "df_mock.loc[42, \"location\"] = np.nan\n",
    "df_mock.loc[88, \"status\"] = np.nan\n",
    "\n",
    "# Save CSV to the current directory (which is now your GitHub repo!)\n",
    "file_name = \"transactions.csv\"\n",
    "df_mock.to_csv(file_name, index=False)\n",
    "print(f\"-> Success! Mock dataset '{file_name}' saved locally.\\n\")\n",
    "\n",
    "# Load and clean\n",
    "df = pd.read_csv(file_name)\n",
    "print(\"--- MISSING VALUES BEFORE CLEANING ---\")\n",
    "print(df.isnull().sum(), \"\\n\")\n",
    "\n",
    "df[\"amount\"] = df[\"amount\"].fillna(df[\"amount\"].median())\n",
    "df[\"location\"] = df[\"location\"].fillna(\"UNKNOWN\")\n",
    "df[\"status\"] = df[\"status\"].fillna(\"UNKNOWN\")\n",
    "\n",
    "print(\"--- MISSING VALUES AFTER CLEANING ---\")\n",
    "print(df.isnull().sum(), \"\\n\")\n",
    "print(\"Step 1 Complete!\")\n",
    "\n"
   ]
